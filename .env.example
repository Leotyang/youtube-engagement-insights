# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=
# Google AI Studio -> Get API key (https://aistudio.google.com/apikey). Free tier, no card.
# Used by src/tag_videos.py. For GitHub Actions, add both keys as repository secrets.
GEMINI_API_KEY=
# Service-account key (JSON) with BigQuery Data Editor + Job User, and the creator sheet shared to its email.
# Keep the file outside the repo, e.g. ~/.config/gcloud/. On GitHub Actions use the secret GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
