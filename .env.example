# Copy to .env and fill in. .env is gitignored; never commit real keys.
# YouTube: Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=
# Anthropic: console.anthropic.com -> API keys. Used by src/tagging.py.
ANTHROPIC_API_KEY=
# Optional: Google Drive for Desktop sync path for scripts/publish_to_drive.sh
# DRIVE_PUBLISH_DIR=/Users/<you>/Library/CloudStorage/GoogleDrive-<acct>/My Drive/DSO 585/Project
