# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=
# Service-account key (JSON). Roles: BigQuery Data Editor + BigQuery Job User (ingest, tagging) and
# Agent Platform User (Gemini tagging via Vertex AI). Share the team Google Sheet with its email.
# Keep the file outside the repo, e.g. ~/.config/gcloud/. On GitHub Actions use the secret GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
